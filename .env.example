# ─────────────────────────────────────────────────────────────
#  Arcade AI — Environment Configuration
#  Copy this file to .env and fill in your API keys
# ─────────────────────────────────────────────────────────────

# ── Gemini API (Required) ────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
# Free tier: 5 requests/min, 20 requests/day per key

# Single key setup (simplest):
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: dedicated paid key for the creator agent
# Unlocks faster generation and no daily quota cap
GEMINI_PAID_KEY=your_paid_gemini_key_here

# Optional: rotate across multiple free-tier keys to multiply quota
# The pipeline automatically switches keys on rate limit (429)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# ... up to GEMINI_API_KEY_20

# ── Claude API (Optional) ────────────────────────────────────
# Used by the Game Logics agent (Phase 2) for detailed mechanics design
# Falls back to Gemini if not set
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Rate Limit Overrides (Optional) ─────────────────────────
# Default values match Gemini free tier — only change if using paid tier
GEMINI_RPM_LIMIT=4        # requests per minute per key (free: 5)
GEMINI_RPD_LIMIT=19       # requests per day per key (free: 20)
GEMINI_RPM_LIMIT_PAID=200 # requests per minute for paid key
